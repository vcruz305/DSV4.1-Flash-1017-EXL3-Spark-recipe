@@ -0,0 +1,44 @@
+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+"""POST /v1/dsv41/kv_snapshot: save the prefix cache for the next start
+(DSV41_KV_PERSIST=1, vllm/v1/core/kv_snapshot.py). Under /v1, so --api-key
+guards it."""
+
+from fastapi import APIRouter, FastAPI, Query, Request
+from fastapi.responses import JSONResponse
+
+from vllm.logger import init_logger
+from vllm.v1.core.kv_snapshot import enabled
+
+logger = init_logger(__name__)
+
+router = APIRouter()
+
+
+@router.post("/v1/dsv41/kv_snapshot")
+async def save_kv_snapshot(raw_request: Request, abort: bool = Query(default=False)):
+    """Write every rank's KV buffer and the scheduler's prefix-cache table.
+
+    The engine must be idle, or ``abort=true`` aborts every running and
+    waiting request first (the scheduler pauses, saves, and resumes). Returns
+    200 with the save summary, or 409 with ``reason`` when nothing was saved.
+    """
+    save = getattr(raw_request.app.state.engine_client, "save_kv_snapshot", None)
+    if save is None:
+        return JSONResponse(
+            content={"saved": False, "reason": "engine client cannot save"},
+            status_code=501,
+        )
+    try:
+        result = await save(abort)
+    except Exception as exc:  # noqa: BLE001 - reported to the caller
+        logger.warning("KV snapshot not saved: %s", exc)
+        return JSONResponse(
+            content={"saved": False, "reason": str(exc)}, status_code=409
+        )
+    return JSONResponse(content=result, status_code=200 if result.get("saved") else 409)
+
+
+def attach_router(app: FastAPI):
+    if enabled():
+        app.include_router(router)
