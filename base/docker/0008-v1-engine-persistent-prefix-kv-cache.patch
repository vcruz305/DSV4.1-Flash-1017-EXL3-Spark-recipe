+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+"""CPU tests of the persistent prefix KV cache: the BlockPool table round trip,
+the rank buffer store (CRC32, epochs, corruption), and the engine core's
+all-ranks-or-none save and restore."""
+
+import json
+import os
+import stat
+from types import SimpleNamespace
+
+import pytest
+import torch
+
+from vllm.model_executor.model_loader import weight_snapshot as ws
+from vllm.v1.core import kv_snapshot as kvs
+from vllm.v1.core.block_pool import BlockPool
+from vllm.v1.core.kv_cache_utils import make_block_hash_with_group_id
+
+NUM_BLOCKS = 64
+
+
+def _hash(i: int) -> bytes:
+    return i.to_bytes(4, "big") * 8
+
+
+def _key(i: int, group: int = 0) -> bytes:
+    return make_block_hash_with_group_id(_hash(i), group)
+
+
+def _populated_pool() -> BlockPool:
+    """A quiesced pool with full blocks in two groups, a partial entry, extra
+    keys on a block, one key on two blocks, and a reordered free queue."""
+    pool = BlockPool(NUM_BLOCKS, enable_caching=True, hash_block_size=16)
+    first = pool.get_new_blocks(10)
+    second = pool.get_new_blocks(6)
+    for i, block in enumerate(first):
+        pool._insert_block_hash(_key(i), block, num_tokens=(i + 1) * 64)
+    for i, block in enumerate(second[:4]):
+        pool._insert_block_hash(_key(100 + i, group=1), block, num_tokens=None)
+    # Partial entries on a block that already has a primary key.
+    pool._insert_block_hash(_key(7, group=2), first[3], num_tokens=48)
+    pool._insert_block_hash(_key(8, group=2), first[3], num_tokens=32)
+    # A duplicate: the same key on a second block.
+    pool._insert_block_hash(_key(2), second[4], num_tokens=192)
+    # Freed in an order that is not the block order (LRU tail first).
+    pool.free_blocks(reversed(second))
+    pool.free_blocks(reversed(first))
+    return pool
+
+
+def test_table_round_trip_reproduces_lookups_and_eviction():
+    pool = _populated_pool()
+    table = json.loads(json.dumps(kvs.dump_table(pool)))
+    fresh = BlockPool(NUM_BLOCKS, enable_caching=True, hash_block_size=16)
+    plan = kvs.check_table(fresh, table)
+    kvs.install_table(fresh, plan)
+
+    assert kvs.dump_table(fresh) == kvs.dump_table(pool)
+    assert plan.num_hashed_blocks == 15
+    assert plan.num_entries == 17
+    for i in list(range(10)) + [100, 101, 102, 103]:
+        group = 1 if i >= 100 else 0
+        want = pool.get_cached_block(_hash(i), [group])
+        got = fresh.get_cached_block(_hash(i), [group])
+        assert [b.block_id for b in got] == [b.block_id for b in want]
+    assert fresh.get_cached_block(_hash(7), [2])[0].block_id == pool.blocks[4].block_id
+    assert fresh.blocks[4].block_hash_num_tokens == 256
+    assert fresh.cached_block_hashes_by_block == pool.cached_block_hashes_by_block
+    # The same blocks are evicted, in the same order, by the next allocations.
+    want_ids = [b.block_id for b in pool.get_new_blocks(NUM_BLOCKS - 1)]
+    got_ids = [b.block_id for b in fresh.get_new_blocks(NUM_BLOCKS - 1)]
+    assert got_ids == want_ids
+    assert len(fresh.cached_block_hash_to_block) == 0
+
+
+def test_dump_refuses_held_blocks():
+    pool = _populated_pool()
+    pool.get_new_blocks(1)
+    with pytest.raises(RuntimeError, match="still held"):
+        kvs.dump_table(pool)
+
+
+def _tampered(table: dict, mutate) -> dict:
+    table = json.loads(json.dumps(table))
+    mutate(table)
+    return table
+
+
+@pytest.mark.parametrize(
+    "mutate",
+    [
+        lambda t: t["free_order"].pop(),
+        lambda t: t["free_order"].__setitem__(0, 0),
+        lambda t: t["blocks"][0].__setitem__(0, NUM_BLOCKS),
+        lambda t: t["blocks"].append(list(t["blocks"][0])),
+        lambda t: t["entries"].pop(),
+        lambda t: t["entries"][0][1].append(t["blocks"][-1][0]),
+        lambda t: t["blocks"][0].__setitem__(1, "zz"),
+        lambda t: t["blocks"][0].__setitem__(2, -1),
+        lambda t: t.pop("entries"),
+    ],
+)
+def test_inconsistent_table_is_corrupt(mutate):
+    table = kvs.dump_table(_populated_pool())
+    fresh = BlockPool(NUM_BLOCKS, enable_caching=True, hash_block_size=16)
+    with pytest.raises(kvs.SnapshotCorrupt):
+        kvs.check_table(fresh, _tampered(table, mutate))
+    assert len(fresh.cached_block_hash_to_block) == 0
+
+
+def test_table_that_does_not_fit_is_unusable_not_corrupt():
+    table = kvs.dump_table(_populated_pool())
+    smaller = BlockPool(NUM_BLOCKS - 1, enable_caching=True, hash_block_size=16)
+    with pytest.raises(kvs.SnapshotUnusable) as info:
+        kvs.check_table(smaller, table)
+    assert not isinstance(info.value, kvs.SnapshotCorrupt)
+    used = _populated_pool()
+    with pytest.raises(kvs.SnapshotUnusable, match="not empty"):
+        kvs.check_table(used, table)
+
+
+# ── rank buffers ────────────────────────────────────────────────────────────────
+
+
+@pytest.fixture
+def small_chunks(monkeypatch):
+    # Several chunks and a ragged tail without allocating 64 MiB slots.
+    monkeypatch.setattr(ws, "_CHUNK", 1 << 16)
+    monkeypatch.setattr(kvs, "_CHUNK", 1 << 16)
+    monkeypatch.setattr(kvs, "_SPACE_MARGIN", 0)
+
+
+def _buffer(seed: int, nbytes: int = 5 * (1 << 16) + 1234) -> torch.Tensor:
+    generator = torch.Generator().manual_seed(seed)
+    return torch.randint(-128, 127, (nbytes,), dtype=torch.int8, generator=generator)
+
+
+def _store(root, key: str = "k" * 64, prefix: str = "rank00of01") -> kvs.SnapshotDir:
+    return kvs.SnapshotDir(root, prefix, key, {"key": key})
+
+
+def test_storage_round_trip_and_modes(tmp_path, small_chunks):
+    source = _buffer(1)
+    store = _store(tmp_path)
+    nbytes = kvs.write_storage(store, source.untyped_storage(), "e1", direct=False)
+    assert nbytes == ws._align(source.numel())
+    for name in (kvs.DATA_FILE, kvs.MANIFEST_FILE, kvs.COMPLETE_FILE):
+        assert stat.S_IMODE(os.stat(store.path / name).st_mode) == 0o600
+    target = torch.zeros_like(source)
+    kvs.restore_storage(store, target.untyped_storage(), "e1", direct=False)
+    assert torch.equal(target, source)
+
+
+def test_epoch_mismatch_is_refused_before_reading(tmp_path, small_chunks):
+    source = _buffer(2)
+    store = _store(tmp_path)
+    kvs.write_storage(store, source.untyped_storage(), "old", direct=False)
+    target = torch.zeros_like(source)
+    with pytest.raises(kvs.SnapshotUnusable, match="from save old") as info:
+        kvs.restore_storage(store, target.untyped_storage(), "new", direct=False)
+    assert not isinstance(info.value, kvs.SnapshotCorrupt)
+    assert not target.any()
+
+
+@pytest.mark.parametrize("damage", ["flip", "truncate", "manifest"])
+def test_damaged_snapshot_is_corrupt(tmp_path, small_chunks, damage):
+    source = _buffer(3)
+    store = _store(tmp_path)
+    kvs.write_storage(store, source.untyped_storage(), "e", direct=False)
+    data = store.path / kvs.DATA_FILE
+    if damage == "flip":
+        raw = bytearray(data.read_bytes())
+        raw[3 * (1 << 16) + 7] ^= 0x40
+        data.write_bytes(bytes(raw))
+    elif damage == "truncate":
+        with open(data, "r+b") as handle:
+            handle.truncate(4096)
+    else:
+        manifest = json.loads((store.path / kvs.MANIFEST_FILE).read_text())
+        manifest["epoch"] = "other"
+        (store.path / kvs.MANIFEST_FILE).write_text(json.dumps(manifest))
+    with pytest.raises(kvs.SnapshotCorrupt):
+        kvs.restore_storage(
+            store, torch.zeros_like(source).untyped_storage(), "e", direct=False
+        )
+
+
+def test_missing_snapshot_names_the_differing_factors(tmp_path, small_chunks):
+    source = _buffer(4)
+    old = kvs.SnapshotDir(tmp_path, "rank00of01", "a" * 64, {"tag": "x", "n": 1})
+    kvs.write_storage(old, source.untyped_storage(), "e", direct=False)
+    new = kvs.SnapshotDir(tmp_path, "rank00of01", "b" * 64, {"tag": "y", "n": 1})
+    with pytest.raises(kvs.SnapshotUnusable, match="differs in tag"):
+        new.manifest()
+    # Saving under the new key keeps no snapshot with another key (KEEP=1).
+    kvs.write_storage(new, source.untyped_storage(), "e2", direct=False, keep=1)
+    assert sorted(p.name for p in tmp_path.iterdir()) == [new.path.name]
+
+
+# ── the engine core: all ranks or none ──────────────────────────────────────────
+
+
+class _Scheduler:
+    def __init__(self, pool: BlockPool):
+        self.kv_cache_manager = SimpleNamespace(block_pool=pool)
+        self.busy = False
+
+    def has_requests(self) -> bool:
+        return self.busy
+
+
+class _Engine:
+    def __init__(self, pool: BlockPool, workers: list):
+        self.vllm_config = None
+        self.scheduler = _Scheduler(pool)
+        self.batch_queue = None
+        self.model_executor = None
+        self.workers = workers
+
+    def collective_rpc(self, method, timeout=None, args=(), kwargs=None):
+        return [method(worker, *args, **(kwargs or {})) for worker in self.workers]
+
+
+def _worker(rank: int, buffer: torch.Tensor):
+    config = SimpleNamespace(
+        kv_cache_tensors=[SimpleNamespace(size=buffer.numel(), host_resident=False)]
+    )
+    half = buffer.numel() // 2
+    runner = SimpleNamespace(
+        kv_cache_config=config, kv_caches=[buffer[:half], buffer[half:]]
+    )
+    return SimpleNamespace(model_runner=runner, vllm_config=SimpleNamespace(rank=rank))
+
+
+@pytest.fixture
+def engine_env(tmp_path, monkeypatch, small_chunks):
+    monkeypatch.setenv(kvs.ENV_DIR, str(tmp_path))
+    monkeypatch.setattr(kvs.KVSnapshot, "_unsupported", lambda self, config: None)
+    monkeypatch.setattr(kvs, "engine_key_factors", lambda *args: {"engine": 1})
+    monkeypatch.setattr(
+        kvs,
+        "rank_key_factors",
+        lambda vllm_config, config, nbytes, engine_key: {
+            "ranks": {"world": [vllm_config.rank, 2]},
+            "engine_key": engine_key,
+            "bytes": nbytes,
+        },
+    )
+    monkeypatch.setattr(kvs, "_open_flags", lambda direct: 0)
+    return tmp_path
+
+
+def _boot(buffers: list[torch.Tensor]) -> tuple[_Engine, kvs.KVSnapshot]:
+    pool = BlockPool(NUM_BLOCKS, enable_caching=True, hash_block_size=16)
+    engine = _Engine(pool, [_worker(r, b) for r, b in enumerate(buffers)])
+    return engine, kvs.KVSnapshot(engine, None, 256, 16)
+
+
+def _saved(root) -> tuple[_Engine, list[torch.Tensor]]:
+    buffers = [_buffer(10), _buffer(11)]
+    engine, snapshot = _boot(buffers)
+    engine.scheduler = _Scheduler(_populated_pool())
+    result = snapshot.save(abort=False)
+    assert result["saved"] and result["ranks"] == 2 and result["cached_blocks"] == 15
+    names = sorted(p.name.split("-")[0] for p in root.iterdir())
+    assert names == ["rank00of02", "rank01of02", "scheduler"]
+    return engine, buffers
+
+
+def test_engine_save_then_restore(engine_env):
+    engine, buffers = _saved(engine_env)
+    fresh = [torch.zeros_like(b) for b in buffers]
+    booted, snapshot = _boot(fresh)
+    snapshot.restore()
+    assert all(torch.equal(a, b) for a, b in zip(fresh, buffers))
+    pool = booted.scheduler.kv_cache_manager.block_pool
+    assert kvs.dump_table(pool) == kvs.dump_table(
+        engine.scheduler.kv_cache_manager.block_pool
+    )
+
+
+def test_empty_cache_saves_nothing_and_drops_the_old_snapshot(engine_env):
+    _, buffers = _saved(engine_env)
+    engine, snapshot = _boot(buffers)
+    result = snapshot.save(abort=False)
+    assert result["saved"] and result["cached_blocks"] == 0
+    assert not any(engine_env.iterdir())
+
+
+def test_abort_pauses_saves_after_the_pause_and_resumes(engine_env):
+    from concurrent.futures import Future
+
+    from vllm.v1.core.sched.interface import PauseState
+
+    buffers = [_buffer(10), _buffer(11)]
+    engine, snapshot = _boot(buffers)
+    engine.scheduler = _Scheduler(_populated_pool())
+    engine.scheduler.busy = True
+    engine.scheduler.pause_state = PauseState.UNPAUSED
+    calls = []
+    pause_done: Future = Future()
+
+    def pause_scheduler(mode, clear_cache):
+        calls.append(("pause", mode, clear_cache))
+        return pause_done
+
+    engine.pause_scheduler = pause_scheduler
+    engine.resume_scheduler = lambda: calls.append(("resume",))
+    result = snapshot.save(abort=True)
+    assert calls == [("pause", "abort", False)] and not result.done()
+    assert not any(engine_env.iterdir())
+    engine.scheduler.busy = False
+    pause_done.set_result(None)
+    assert result.result()["saved"] and calls[-1] == ("resume",)
+
+
+def test_engine_refuses_while_busy_without_abort(engine_env):
+    engine, snapshot = _boot([_buffer(1)])
+    engine.scheduler.busy = True
+    with pytest.raises(RuntimeError, match="requests are running"):
+        snapshot.save(abort=False)
+    assert not any(engine_env.iterdir())
+
+
+def test_engine_writes_no_table_when_a_rank_fails(engine_env):
+    engine, snapshot = _boot([_buffer(1), _buffer(2)])
+    engine.scheduler = _Scheduler(_populated_pool())
+    engine.workers[1].model_runner.kv_caches = [torch.zeros(8, dtype=torch.int8)]
+    result = snapshot.save(abort=False)
+    assert not result["saved"] and "rank 1 not written" in result["reason"]
+    assert not any(p.name.startswith("scheduler-") for p in engine_env.iterdir())
+
+
+def test_corrupt_rank_restores_nothing_and_deletes(engine_env):
+    _, buffers = _saved(engine_env)
+    rank1 = next(engine_env.glob("rank01of02-*"))
+    raw = bytearray((rank1 / kvs.DATA_FILE).read_bytes())
+    raw[100] ^= 1
+    (rank1 / kvs.DATA_FILE).write_bytes(bytes(raw))
+    booted, snapshot = _boot([torch.zeros_like(b) for b in buffers])
+    snapshot.restore()
+    pool = booted.scheduler.kv_cache_manager.block_pool
+    assert len(pool.cached_block_hash_to_block) == 0
+    assert pool.get_num_free_blocks() == NUM_BLOCKS - 1
+    # The corrupt rank snapshot and the now incomplete set's table are gone.
+    assert sorted(p.name.split("-")[0] for p in engine_env.iterdir()) == ["rank00of02"]
+
+
+def test_stale_rank_epoch_restores_nothing(engine_env):
+    _, buffers = _saved(engine_env)
+    rank1 = next(engine_env.glob("rank01of02-*"))
+    stale = engine_env / "stale"
+    os.rename(rank1, stale)
+    # A second save; then rank 1 is put back to the first save's snapshot.
+    engine, snapshot = _boot(buffers)
+    engine.scheduler = _Scheduler(_populated_pool())
+    assert snapshot.save(abort=False)["saved"]
+    rank1 = next(engine_env.glob("rank01of02-*"))
+    os.rename(rank1, engine_env / "second")
+    os.rename(stale, rank1)
+    booted, snapshot = _boot([torch.zeros_like(b) for b in buffers])
+    snapshot.restore()
+    assert (
+        len(booted.scheduler.kv_cache_manager.block_pool.cached_block_hash_to_block)
+        == 0
+    )
+    # Not corrupt: nothing is deleted.
+    assert any(p.name.startswith("scheduler-") for p in engine_env.iterdir())
+
+
+def test_corrupt_table_is_deleted(engine_env):
+    _saved(engine_env)
+    table_dir = next(engine_env.glob("scheduler-*"))
+    (table_dir / kvs.COMPLETE_FILE).write_text("0" * 64)
+    booted, snapshot = _boot(
+        [torch.zeros_like(_buffer(10)), torch.zeros_like(_buffer(11))]
+    )
+    snapshot.restore()
+    assert (
+        len(booted.scheduler.kv_cache_manager.block_pool.cached_block_hash_to_block)
+        == 0
+    )
+    assert not table_dir.exists()
+
+
+def test_rank_failures_lists_each_failed_rank():
+    results = [{"ok": True}, {"ok": False, "reason": "no snapshot"}, None]
+    assert kvs.rank_failures(results, "not restored") == [
+        "rank 1 not restored: no snapshot",
+        "rank 2 not restored: None",
+    ]
+
+
+def test_key_helpers_are_deterministic_and_address_free():
+    from vllm.utils.hashing import sha256
+    from vllm.v1.core.kv_cache_utils import init_none_hash
+    from vllm.v1.kv_cache_interface import KVCacheGroupRole, KVCacheTensor
+
+    init_none_hash(sha256)
+    probe = kvs._hash_probe("sha256")
+    assert probe == kvs._hash_probe("sha256") and len(probe) == 64
+    value = {
+        "tensor": KVCacheTensor(
+            size=4096, layers=["a", "b"], layer_stride=1, block_stride=2
+        ),
+        "role": KVCacheGroupRole.DEFAULT,
+        "dtype": torch.bfloat16,
+        "object": object(),
+    }
+    plain = kvs._plain(value)
+    assert plain["role"] == "default" and plain["dtype"] == "torch.bfloat16"
+    assert plain["object"] == "object"
+    assert plain["tensor"]["fields"]["layers"] == ["a", "b"]
+    assert kvs._digest(value) == kvs._digest(dict(value, object=object()))
+
+
+def test_per_process_environment_does_not_change_the_key(monkeypatch):
+    monkeypatch.setenv("DSV41_SOMETHING", "kept")
+    keys = []
+    for boot in ("a" * 32, "b" * 32):
+        monkeypatch.setenv(
+            "VLLM_OBJECT_STORAGE_SHM_BUFFER_NAME",
+            f"VLLM_OBJECT_STORAGE_SHM_BUFFER_{boot}",
+        )
+        monkeypatch.setenv("VLLM_DIST_IDENT", boot)
+        monkeypatch.setenv("DSV41_KV_PERSIST", "1" if boot[0] == "a" else "0")
+        env = kvs._environment_factors()
+        assert env == ws._environment()
+        assert "VLLM_OBJECT_STORAGE_SHM_BUFFER_NAME" not in env
+        assert env["DSV41_SOMETHING"] == "kept"
+        keys.append(kvs._key_of({"environment": env}))
+    assert keys[0] == keys[1]
