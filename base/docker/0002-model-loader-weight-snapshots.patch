@@ -0,0 +1,237 @@
+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+"""CPU tests of the per-rank weight snapshot: layout, chunking, replay, CRC,
+and the load-side-effect guard."""
+
+import pytest
+import torch
+from torch import nn
+
+from vllm.model_executor.model_loader import weight_snapshot as ws
+
+
+class _Helper:
+    """A plain object holding a tensor, as kernel wrappers do."""
+
+    def __init__(self, tensor: torch.Tensor):
+        self.tensor = tensor
+
+
+class _Table(nn.Module):
+    def __init__(self):
+        super().__init__()
+        # Disk-backed table: only file references are recorded at load.
+        self._disk_sources: list[tuple[str, int, bool]] = []
+        self.packed = nn.Parameter(
+            torch.zeros(4097, dtype=torch.uint8), requires_grad=False
+        )
+
+
+class _Block(nn.Module):
+    def __init__(self, shared: nn.Parameter):
+        super().__init__()
+        base = torch.zeros(24, 40, dtype=torch.bfloat16)
+        # Non-contiguous parameter over a larger storage.
+        self.weight_t = nn.Parameter(base.t(), requires_grad=False)
+        # Two parameters viewing one storage.
+        fused = torch.zeros(10, 8)
+        self.first = nn.Parameter(fused[:4], requires_grad=False)
+        self.second = nn.Parameter(fused[4:], requires_grad=False)
+        self.shared = shared
+        self.register_buffer("scale", torch.ones(3, dtype=torch.float64))
+        self.register_buffer("steps", torch.arange(5), persistent=False)
+        # Plain attributes: an alias of a parameter and a helper object.
+        self.alias = self.first.data
+        self.helper = _Helper(self.second.data[1:])
+        self.flag = "initial"
+
+
+class _Model(nn.Module):
+    def __init__(self, width: int = 16):
+        super().__init__()
+        self.embed = nn.Parameter(torch.zeros(width, 33), requires_grad=False)
+        self.blocks = nn.ModuleList([_Block(self.embed) for _ in range(3)])
+        self.table = _Table()
+        self.big = nn.Parameter(
+            torch.zeros(3 * 4096 + 17, dtype=torch.float16), requires_grad=False
+        )
+        self.ghost = nn.Parameter(torch.empty(7, 3, device="meta"), requires_grad=False)
+
+
+def _load(model: _Model, seed: int) -> None:
+    """A load: tensor contents (through .copy_ and .data) and plain-data records."""
+    generator = torch.Generator().manual_seed(seed)
+    for name, param in model.named_parameters():
+        if param.device.type == "meta":
+            continue
+        values = torch.randint(
+            0, 255, param.shape, generator=generator, dtype=torch.uint8
+        )
+        if name.endswith("big"):
+            param.data.copy_(values.to(param.dtype))
+        else:
+            param.copy_(values.to(param.dtype))
+    model.table._disk_sources.append(
+        ("/models/model-00047-of-00048.safetensors", 4096, False)
+    )
+    model.table._disk_sources.append(
+        ("/models/model-00048-of-00048.safetensors", 8192, True)
+    )
+
+
+def _state(model: nn.Module) -> dict[str, torch.Tensor]:
+    out = {}
+    for name, tensor in [
+        *model.named_parameters(remove_duplicate=False),
+        *model.named_buffers(remove_duplicate=False),
+    ]:
+        if tensor.device.type != "meta":
+            out[name] = tensor.detach().contiguous().view(-1).view(torch.uint8).clone()
+    return out
+
+
+@pytest.fixture(autouse=True)
+def small_chunks(monkeypatch):
+    # Small chunks so storages straddle chunk boundaries.
+    monkeypatch.setattr(ws, "_CHUNK", 8192)
+
+
+def _store(tmp_path, key="k" * 64, factors=None):
+    return ws.SnapshotStore(
+        tmp_path, "rank00of01", key, factors or {"tag": "a"}, direct=False
+    )
+
+
+def _write(tmp_path, model, seed=1, **kwargs):
+    probe = ws.LoadProbe(model)
+    _load(model, seed)
+    owned = {ws._storage_key_of(s) for s in ws._layout(model).storages}
+    replay, problems = probe.changes(model, owned)
+    assert problems == []
+    store = _store(tmp_path, **kwargs)
+    store.write(model, replay)
+    return store, replay
+
+
+def test_round_trip_restores_every_storage_and_replays(tmp_path):
+    source = _Model()
+    store, replay = _write(tmp_path, source)
+    assert [op["attr"] for op in replay] == ["_disk_sources"]
+    assert (store.path / ws.COMPLETE_FILE).is_file()
+    assert (store.path / ws.DATA_FILE).stat().st_size % 4096 == 0
+
+    target = _Model()
+    torch.manual_seed(5)
+    for param in target.parameters():
+        if param.device.type != "meta":
+            param.data.copy_(torch.randn(param.shape).to(param.dtype))
+    sources = target.table._disk_sources
+    reader = _store(tmp_path)
+    layout = reader.check(target)
+    reader.restore(target, layout)
+
+    expected, actual = _state(source), _state(target)
+    assert expected.keys() == actual.keys()
+    for name in expected:
+        assert torch.equal(expected[name], actual[name]), name
+    assert target.table._disk_sources is sources
+    assert sources == source.table._disk_sources
+    assert isinstance(sources[0], tuple)
+    # Views and plain-attribute aliases see the restored storage.
+    assert torch.equal(target.blocks[0].alias, target.blocks[0].first)
+    assert torch.equal(target.blocks[1].helper.tensor, target.blocks[1].second[1:])
+    assert target.blocks[2].shared is target.embed
+    assert ws.digest_model(source)["summary"] == ws.digest_model(target)["summary"]
+
+
+def test_layout_mismatch_is_refused(tmp_path):
+    _write(tmp_path, _Model())
+    with pytest.raises(ws.SnapshotUnusable, match="layout differs"):
+        _store(tmp_path).check(_Model(width=17))
+
+
+def test_missing_snapshot_names_differing_key_factors(tmp_path):
+    _write(tmp_path, _Model(), key="a" * 64, factors={"env": {"X": "1"}, "tag": "t"})
+    other = _store(tmp_path, key="b" * 64, factors={"env": {"X": "2"}, "tag": "t"})
+    with pytest.raises(ws.SnapshotUnusable, match=r"differs in env\.X"):
+        other.check(_Model())
+
+
+def test_corrupt_chunk_is_detected(tmp_path):
+    store, _ = _write(tmp_path, _Model())
+    with open(store.path / ws.DATA_FILE, "r+b") as handle:
+        handle.seek(9000)
+        byte = handle.read(1)
+        handle.seek(9000)
+        handle.write(bytes([byte[0] ^ 0xFF]))
+    target = _Model()
+    reader = _store(tmp_path)
+    with pytest.raises(ws.SnapshotUnusable, match="CRC32"):
+        reader.restore(target, reader.check(target))
+
+
+def test_tampered_manifest_is_refused(tmp_path):
+    store, _ = _write(tmp_path, _Model())
+    manifest = store.path / ws.MANIFEST_FILE
+    manifest.write_bytes(manifest.read_bytes().replace(b'"replay"', b'"replay" '))
+    with pytest.raises(ws.SnapshotUnusable, match="COMPLETE"):
+        _store(tmp_path).check(_Model())
+
+
+def test_replay_precondition(tmp_path):
+    _write(tmp_path, _Model())
+    target = _Model()
+    target.table._disk_sources.append(("/elsewhere", 0, False))
+    with pytest.raises(ws.SnapshotUnusable, match="does not start where"):
+        _store(tmp_path).check(target)
+
+
+@pytest.mark.parametrize(
+    "mutate",
+    [
+        lambda m: setattr(m.blocks[0], "first", nn.Parameter(torch.ones(4, 8))),
+        lambda m: m.blocks[1].register_buffer("extra", torch.ones(2)),
+        lambda m: setattr(m.blocks[2], "helper", _Helper(torch.ones(1))),
+        lambda m: setattr(m.blocks[2], "flag", object()),
+        lambda m: setattr(m, "cache", torch.ones(2)),
+    ],
+    ids=["replaced-param", "new-buffer", "new-object", "object-attr", "new-tensor"],
+)
+def test_unreplayable_load_side_effects_block_the_write(mutate):
+    model = _Model()
+    probe = ws.LoadProbe(model)
+    _load(model, 1)
+    mutate(model)
+    owned = {ws._storage_key_of(s) for s in ws._layout(model).storages}
+    _, problems = probe.changes(model, owned)
+    assert problems
+
+
+def test_plain_tensor_written_outside_parameters_blocks_the_write():
+    model = _Model()
+    model.blocks[0].workspace = torch.zeros(4)
+    probe = ws.LoadProbe(model)
+    _load(model, 1)
+    model.blocks[0].workspace.add_(1)
+    owned = {ws._storage_key_of(s) for s in ws._layout(model).storages}
+    _, problems = probe.changes(model, owned)
+    assert any("workspace" in p for p in problems)
+
+
+def test_overlapping_storages_are_refused():
+    model = _Model()
+    blob = torch.zeros(64, dtype=torch.uint8)
+    # A second storage over part of the first's memory, as a raw-pointer alias
+    # would be (identical spans are one storage; partial overlap is refused).
+    alias = torch.frombuffer(blob[8:].numpy(), dtype=torch.uint8)
+    model.a = nn.Parameter(blob[:32], requires_grad=False)
+    model.b = nn.Parameter(alias[16:], requires_grad=False)
+    with pytest.raises(ws.SnapshotUnusable, match="overlap"):
+        ws._layout(model)
+
+
+def test_plain_data_encoding_round_trips():
+    value = [("p", 1, True), {"k": [1.5, None, "s"]}, (), []]
+    assert ws._decode(ws._encode(value)) == value
+    with pytest.raises(ws._NotData):
+        ws._encode(torch.float32)
