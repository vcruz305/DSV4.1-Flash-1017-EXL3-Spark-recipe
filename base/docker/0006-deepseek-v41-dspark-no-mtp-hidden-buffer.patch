@@ -533,7 +533,6 @@ def test_model_forward_matches_full_rows(
             use_sequence_parallel=False,
             prefill_sp_min_rows=min_rows,
             prefill_sp_unreduced=False,
-            prefill_sp_skips_mtp_buffer=skip_mtp_buffer,
             disk_engram=False,
             engram_hash=None,
             start_layer=0,
@@ -541,7 +540,8 @@ def test_model_forward_matches_full_rows(
             ced_decoder_start=None,
             layers=nn.ModuleList(_Layer(i, world, local_rows) for i in range(3)),
             aux_hidden_state_layers={2, 3},
-            _mtp_hidden_buffer=buffer,
+            # DSpark drafts from the aux hidden states and has no MTP buffer.
+            _mtp_hidden_buffer=None if skip_mtp_buffer else buffer,
             # L2 prefetch is on by default on SM121; its plans are built.
             _l2pf_ready=True,
             norm=lambda hidden: hidden * 2,
diff --git a/vllm/models/deepseek_v4_1/nvidia/model.py b/vllm/models/deepseek_v4_1/nvidia/model.py
index 61396ebfb..9b6332b64 100644
