+++ b/vllm/models/deepseek_v4_1/nvidia/model.py
@@ -542,8 +542,12 @@ class DeepseekV4Model(nn.Module, EagleModelMixin):
             self.norm = PPMissingLayer()
 
         spec_config = vllm_config.speculative_config
-        needs_mtp_hidden_states = spec_config is not None and (
-            spec_config.use_eagle() or spec_config.uses_draft_model()
+        # DSpark drafts from the aux hidden states only (its speculator keeps its
+        # own context buffer), so it needs no pre-collapse MTP buffer.
+        needs_mtp_hidden_states = (
+            spec_config is not None
+            and (spec_config.use_eagle() or spec_config.uses_draft_model())
+            and not spec_config.use_dspark()
         )
         if get_pp_group().is_last_rank and needs_mtp_hidden_states:
             self._mtp_hidden_buffer = torch.empty(
@@ -553,10 +557,6 @@ class DeepseekV4Model(nn.Module, EagleModelMixin):
             )
         else:
             self._mtp_hidden_buffer = None
-        # DSpark drafts from the aux hidden states only; SP leaves this buffer.
-        self.prefill_sp_skips_mtp_buffer = (
-            spec_config is not None and spec_config.use_dspark()
-        )
 
     def prepare_disk_engram(
         self, input_ids, query_start_loc, lookback_token_ids, early=None
@@ -836,9 +836,7 @@ class DeepseekV4Model(nn.Module, EagleModelMixin):
 
         # MTP needs full HC states; otherwise collapse and normalize locally
         # before gathering to reduce communication.
-        if self._mtp_hidden_buffer is not None and not (
-            sp is not None and self.prefill_sp_skips_mtp_buffer
-        ):
+        if self._mtp_hidden_buffer is not None:
             if self.use_sequence_parallel:
                 hidden_states = sp_all_gather(hidden_states)[:full_num_tokens]
                 pre_mix = sp_all_gather(pre_mix)[:full_num_tokens]
diff --git a/vllm/models/deepseek_v4_1/sp_prefill.py b/vllm/models/deepseek_v4_1/sp_prefill.py
index 7b728f379..ef6d10da0 100644
--- a/vllm/models/deepseek_v4_1/sp_prefill.py
+++ b/vllm/models/deepseek_v4_1/sp_prefill.py
@@ -63,8 +63,7 @@ reduce-scatters its masked partial rows (each token has one owning
 vocabulary shard, so the sum is exact); ``inputs_embeds`` are sliced. After
 the final collapse and norm, and for every aux hidden state a drafter
 consumes, the rows are gathered back to T. DSpark drafts from the aux hidden
-states only, so its pre-collapse MTP buffer is not filled under SP; other
-drafters gather it.
+states only and has no pre-collapse MTP buffer; other drafters gather it.
 
 ## Unreduced results
 
