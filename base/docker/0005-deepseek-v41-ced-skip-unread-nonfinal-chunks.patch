+def _nonfinal_skip_policy(vllm_config: VllmConfig) -> tuple[int, int]:
+    """``nonfinal_limits``' ``(min_remaining, chunk_align)``, or ``(0, 0)`` when
+    non-final prefill chunks keep their decoder rows.
+
+    The decoder rows of a chunk are skipped only when the scheduler's
+    ``ALIGN_PREFILL_CHUNKS`` (TileLang family) ends every prefill chunk on a
+    multiple of ``long_prefill_token_threshold``: the next chunk then holds
+    ``min(remaining, threshold)`` rows. ``min_remaining`` covers the decoder's
+    window, the DSpark drafter's SWA index width (its reach back from a draft's
+    first position) and the step's sampled and draft rows, one row past each.
+    Other drafters, and ``DSV41_CED_SKIP_NONFINAL=0``, keep every chunk's rows.
+    """
+    if os.environ.get("DSV41_CED_SKIP_NONFINAL", "1") != "1":
+        return 0, 0
+    # vllm/v1/core/sched/scheduler.py ALIGN_PREFILL_CHUNKS.
+    if envs.VLLM_DS41_KERNEL_BACKEND != "tilelang":
+        return 0, 0
+    scheduler = vllm_config.scheduler_config
+    align = scheduler.long_prefill_token_threshold
+    if not scheduler.enable_chunked_prefill or align <= 0:
+        return 0, 0
+    hf = vllm_config.model_config.hf_config
+    reach, rows = max(CED_WINDOW, int(hf.sliding_window)), 1
+    spec = vllm_config.speculative_config
+    if spec is not None:
+        if not spec.use_dspark():
+            return 0, 0
+        window = getattr(spec.draft_model_config.hf_config, "sliding_window", None)
+        reach = max(
+            reach,
+            get_dspark_swa_index_width(
+                hf.sliding_window if window is None else window,
+                spec.num_speculative_tokens,
+            ),
+        )
+        rows += spec.num_speculative_tokens
+    min_remaining = reach + 1 + rows
+    return (min_remaining, align) if align >= min_remaining else (0, 0)
+
